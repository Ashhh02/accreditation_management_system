# Copy to `.env` and fill in real values. Never commit `.env`.

# Django
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# Demo mode (defaults to DEBUG). Production must set DEMO_MODE=False so demo
# accounts and the default development password are disabled.
DEMO_MODE=False

# HTTPS (defaults to the opposite of DEBUG). Behind a load balancer/TLS proxy
# keep this True with SECURE_PROXY_SSL_HEADER in settings.
DJANGO_ENABLE_HTTPS=True

# Caching. Development uses LocMemCache automatically; production should point
# at Redis (the built-in Django Redis backend):
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://redis:6379/1

# Realtime (WebSockets). When REDIS_URL is set, Channels uses the Redis-backed
# layer so events fan out across processes. Without it the in-memory layer is
# used (single-process development).
# REDIS_URL=redis://redis:6379/1

# Database. SQLite is the default; switch to PostgreSQL in production.
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=ams
# DJANGO_DB_USER=ams
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=db
# DJANGO_DB_PORT=5432

# AI / AVA (AI Insights & Assistant) (optional). When both are set, answers are
# composed by an OpenAI-compatible /chat/completions endpoint grounded in the
# live data. Without them, the built-in engine answers deterministically from
# the database.
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT=20
# AI_MAX_TOKENS=900